# ============================================================================
# Secure Code Vulnerability Detection Platform — Environment Configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ============================================================================

# --- App ---
APP_NAME="Secure Code Vulnerability Detection Platform"
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:5500

# --- Security / JWT ---
SECRET_KEY=change-this-to-a-long-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# --- Database ---
DATABASE_URL=sqlite:///./secure_code_platform.db

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME="Secure Code Platform"
SMTP_FROM_EMAIL=no-reply@securecode.dev
SMTP_USE_TLS=true

# =============================================================================
# --- Engine 2 / Explainable AI: LLM Provider ---
#
# Choose ONE provider by setting AI_PROVIDER, then supply the matching key.
# The other providers' keys are ignored.
#
#   Option A — Anthropic Claude  (https://console.anthropic.com/)
#   Option B — OpenAI GPT        (https://platform.openai.com/api-keys)
#   Option C — Google Gemini     (https://aistudio.google.com/app/apikey)
# =============================================================================

# Which provider to use: anthropic | openai | gemini
AI_PROVIDER=gemini

# --- Option A: Anthropic Claude ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
AI_AUDIT_MODEL=claude-sonnet-4-6        # claude-opus-4-5 | claude-sonnet-4-6 | claude-haiku-4-5
AI_AUDIT_MAX_TOKENS=4096

# --- Option B: OpenAI GPT ---
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o                     # gpt-4o | gpt-4-turbo | gpt-4 | gpt-3.5-turbo

# --- Option C: Google Gemini ---
GEMINI_API_KEY=sk-your-gemini-key-here
GEMINI_MODEL=gemini-3.6-flash            # gemini-1.5-pro | gemini-1.5-flash | gemini-pro

# =============================================================================

# --- Engine 1: CodeQL ---
CODEQL_CLI_PATH="C:\CodeQL\codeql\codeql.exe"
CODEQL_QUERY_SUITE=security-extended
CODEQL_DB_DIR=./codeql_dbs
CODEQL_TIMEOUT_SECONDS=300

# --- Engine 3: ML Classifier ---
ML_MODEL_PATH=./ml_artifacts/vuln_classifier.joblib
ML_VECTORIZER_PATH=./ml_artifacts/vectorizer.joblib
ML_CONFIDENCE_THRESHOLD=0.55

# --- File Uploads ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=.py,.js,.ts,.java,.go,.rb,.php,.c,.cpp,.cs,.zip

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=60
